# ======================
# MEMÓRIA
# ======================
def load_memory():
    if os.path.exists(MEMORY_FILE):
        with open(MEMORY_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {
        "user_name": None,
        "history": [],
        "last_topic": None,
        "used_facts": [],
        "learned_facts": [],
        "asked_questions": []
    }

def save_memory(mem):
    with open(MEMORY_FILE, "w", encoding="utf-8") as f:
        json.dump(mem, f, ensure_ascii=False, indent=2)

memory = load_memory()

# ======================
# NORMALIZAÇÃO LINGUAGEM DIGITAL
# ======================
DIGITAL = {
    "vc": "você", "pq": "por que", "oq": "o que",
    "q": "que", "tb": "também", "ta": "está", "tá": "está",
    "n": "não", "nn": "não", "kd": "cadê", "flw": "falou"
}

def normalize(text):
    text = text.lower()
    for k, v in DIGITAL.items():
        text = re.sub(r"\b"+re.escape(k)+r"\b", v, text)
    return re.sub(r"\s+", " ", text).strip()

